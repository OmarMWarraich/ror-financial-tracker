FROM postgres:16@sha256:5db6dac2ef5dcff512f4f00a009c3c332b9f2f28f24277175bf3e4a3d02ef83a AS vector-build

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y build-essential ca-certificates curl postgresql-server-dev-16 && \
    curl --fail --location --silent --show-error \
      https://github.com/pgvector/pgvector/archive/refs/tags/v0.8.1.tar.gz -o /tmp/pgvector.tar.gz && \
    echo "a9094dfb85ccdde3cbb295f1086d4c71a20db1d26bf1d6c39f07a7d164033eb4  /tmp/pgvector.tar.gz" | sha256sum --check && \
    tar -xzf /tmp/pgvector.tar.gz -C /tmp && \
    make -C /tmp/pgvector-0.8.1 OPTFLAGS="" && \
    make -C /tmp/pgvector-0.8.1 install

FROM postgres:16@sha256:5db6dac2ef5dcff512f4f00a009c3c332b9f2f28f24277175bf3e4a3d02ef83a
COPY --from=vector-build /usr/lib/postgresql/16/lib/vector.so /usr/lib/postgresql/16/lib/
COPY --from=vector-build /usr/share/postgresql/16/extension/vector* /usr/share/postgresql/16/extension/
