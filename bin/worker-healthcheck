#!/usr/bin/env ruby
require "bundler/setup"
require "socket"
require "sidekiq/api"

Sidekiq.configure_client do |config|
  config.redis = { url: ENV.fetch("REDIS_URL"), network_timeout: 3, pool_timeout: 3 }
end

healthy = Sidekiq::ProcessSet.new.any? do |process|
  process["hostname"] == Socket.gethostname && process["queues"].include?(ENV.fetch("WORKER_QUEUE", "maintenance"))
end
abort "No current Sidekiq heartbeat for this container" unless healthy
