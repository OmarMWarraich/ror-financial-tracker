#!/usr/bin/env ruby
require "fileutils"
require "json"
require "open3"
require "securerandom"

Dir.chdir(File.expand_path("..", __dir__))
File.umask(0o077)

def capture!(*command, input: "")
  output, error, status = Open3.capture3(*command, stdin_data: input)
  raise "#{command.first} failed: #{error}" unless status.success?
  output.strip
end

def run!(*command, **options)
  raise "#{command.first} failed" unless system(*command, **options)
end

def query(container, database, sql)
  capture!("docker", "exec", "-i", container, "psql", "-XAt", "-v", "ON_ERROR_STOP=1",
           "-U", "rails", "-d", database, input: sql)
end

def fingerprint(container, database)
  tables = JSON.parse(query(container, database, <<~SQL))
    SELECT COALESCE(json_agg(tablename ORDER BY tablename), '[]'::json)
    FROM pg_tables WHERE schemaname = 'public';
  SQL
  rows = tables.to_h do |table|
    quoted = %("#{table.gsub('"', '""')}")
    digest = query(container, database, <<~SQL)
      SELECT count(*) || ':' ||
        md5(COALESCE(string_agg(md5(row_to_json(r)::text), '' ORDER BY md5(row_to_json(r)::text)), ''))
      FROM public.#{quoted} r;
    SQL
    [table, digest]
  end
  rows["triggers"] = query(container, database, <<~SQL)
    SELECT COALESCE(string_agg(pg_get_triggerdef(oid), E'\\n' ORDER BY tgname), '')
    FROM pg_trigger WHERE NOT tgisinternal AND tgrelid IN
      (SELECT oid FROM pg_class WHERE relnamespace = 'public'::regnamespace);
  SQL
  rows["indexes"] = query(container, database, <<~SQL)
    SELECT COALESCE(string_agg(indexdef, E'\\n' ORDER BY indexname), '')
    FROM pg_indexes WHERE schemaname = 'public';
  SQL
  rows
end

source = capture!("docker", "compose", "--env-file", ".env.docker", "ps", "-q", "postgres")
raise "Expected exactly one running Compose PostgreSQL container" unless source.match?(/\A[0-9a-f]{12,64}\z/)
version = query(source, "financial_tracker_development", "SHOW server_version_num")
raise "This rehearsal requires PostgreSQL 16" unless version.to_i.between?(160000, 169999)

name = "financial-tracker-vector-rehearsal-#{SecureRandom.hex(6)}"
backup_directory = File.join("storage", "backups", name)
FileUtils.mkdir_p(backup_directory, mode: 0o700)
backup = File.join(backup_directory, "development.dump")
before = fingerprint(source, "financial_tracker_development")
File.open(backup, File::WRONLY | File::CREAT | File::EXCL, 0o600) do |file|
  run!("docker", "exec", source, "pg_dump", "-U", "rails", "-d", "financial_tracker_development",
       "--format=custom", "--no-owner", out: file)
end
puts "Private backup retained at #{backup} (0600; contains application data)."
created = false
begin
  capture!("docker", "create", "--name", name, "--network", "none",
           "--tmpfs", "/var/lib/postgresql/data:rw",
           "-e", "POSTGRES_HOST_AUTH_METHOD=trust", "-e", "POSTGRES_USER=rails",
           "-e", "POSTGRES_DB=rehearsal", "ror-financial-tracker-postgres:16.15-vector0.8.1",
           "postgres", "-c", "listen_addresses=")
  created = true
  capture!("docker", "start", name)
  ready = 120.times.any? do
    sleep 0.5
    _, _, status = Open3.capture3("docker", "exec", name, "sh", "-c",
                                'test "$(cat /proc/1/comm)" = postgres && pg_isready -U rails -d rehearsal')
    status.success?
  end
  raise "Isolated PostgreSQL did not become ready" unless ready
  File.open(backup, "rb") do |file|
    run!("docker", "exec", "-i", name, "pg_restore", "-U", "rails", "-d", "rehearsal",
         "--no-owner", "--exit-on-error", in: file)
  end
  raise "Source changed during rehearsal; repeat during a quiet window" unless before == fingerprint(source, "financial_tracker_development")
  raise "Restored rows, indexes or triggers differ" unless before == fingerprint(name, "rehearsal")
  query(name, "rehearsal", "CREATE EXTENSION IF NOT EXISTS vector")
  raise "Wrong pgvector version" unless query(name, "rehearsal", "SELECT extversion FROM pg_extension WHERE extname='vector'") == "0.8.1"
  result = query(name, "rehearsal", <<~SQL)
    BEGIN;
    CREATE TEMP TABLE rehearsal_relations (id integer PRIMARY KEY, label text NOT NULL);
    CREATE TEMP TABLE rehearsal_vectors (id integer REFERENCES rehearsal_relations(id), value vector(3));
    INSERT INTO rehearsal_relations VALUES (1, 'nearest'), (2, 'other');
    INSERT INTO rehearsal_vectors VALUES (1, '[1,0,0]'), (2, '[0,1,0]');
    SELECT label FROM rehearsal_relations JOIN rehearsal_vectors USING (id)
      ORDER BY value <=> '[1,0,0]' LIMIT 1;
    CREATE TEMP TABLE rehearsal_ledger (id integer);
    CREATE TRIGGER rehearsal_immutable BEFORE UPDATE OR DELETE ON rehearsal_ledger
      FOR EACH ROW EXECUTE FUNCTION public.sandbox_reject_mutation();
    INSERT INTO rehearsal_ledger VALUES (1);
    DO $$
    BEGIN
      UPDATE rehearsal_ledger SET id=2;
      RAISE EXCEPTION 'Ledger trigger did not reject mutation';
    EXCEPTION WHEN raise_exception THEN
      IF SQLERRM <> 'Synthetic ledger rows are append-only' THEN RAISE; END IF;
    END;
    $$;
    ROLLBACK;
  SQL
  raise "Vector/relational join failed" unless result.lines.map(&:strip).include?("nearest")
  query(name, "rehearsal", <<~SQL)
    CREATE SCHEMA vector_rehearsal;
    CREATE TABLE vector_rehearsal.records (id integer PRIMARY KEY, label text NOT NULL);
    CREATE TABLE vector_rehearsal.embeddings (
      record_id integer REFERENCES vector_rehearsal.records(id), embedding vector(1536) NOT NULL
    );
    INSERT INTO vector_rehearsal.records VALUES (1, 'synthetic-roundtrip');
    INSERT INTO vector_rehearsal.embeddings
      VALUES (1, array_prepend(1::real, array_fill(0::real, ARRAY[1535]))::vector);
  SQL
  roundtrip_backup = File.join(backup_directory, "vector-roundtrip.dump")
  File.open(roundtrip_backup, File::WRONLY | File::CREAT | File::EXCL, 0o600) do |file|
    run!("docker", "exec", name, "pg_dump", "-U", "rails", "-d", "rehearsal",
         "--format=custom", "--no-owner", out: file)
  end
  query(name, "rehearsal", "CREATE DATABASE vector_roundtrip TEMPLATE template0")
  File.open(roundtrip_backup, "rb") do |file|
    run!("docker", "exec", "-i", name, "pg_restore", "-U", "rails", "-d", "vector_roundtrip",
         "--no-owner", "--exit-on-error", in: file)
  end
  raise "Populated vector roundtrip changed public data" unless before == fingerprint(name, "vector_roundtrip")
  roundtrip = query(name, "vector_roundtrip", <<~SQL)
    SELECT label FROM vector_rehearsal.records JOIN vector_rehearsal.embeddings ON record_id = id
      WHERE vector_dims(embedding) = 1536
        AND embedding <=> array_prepend(1::real, array_fill(0::real, ARRAY[1535]))::vector = 0;
  SQL
  raise "Populated 1536-dimensional vector restore failed" unless roundtrip == "synthetic-roundtrip"
  puts "Restore, complete row fingerprints, indexes, ledger triggers, SQL rollback and pgvector 0.8.1 verified."
  puts "Populated 1536-dimensional vectors survived a second dump/restore alongside the original public tables."
  puts "The source database and its volume were not modified."
ensure
  run!("docker", "rm", "--force", name, out: File::NULL) if created
end
