<aside id="application-navigation" class="shell-sidebar" aria-label="Application navigation" data-shell-target="sidebar" data-action="keydown->shell#trapFocus">
  <div class="shell-brand">
    <%= link_to root_path, class: "shell-brand-link", aria: { label: "FinanceTracker home" } do %>
      <span class="brand-mark" aria-hidden="true"><%= fa_icon "line-chart" %></span>
      <span class="sidebar-label">FinanceTracker</span>
    <% end %>
    <button type="button" class="icon-button sidebar-close" aria-label="Close navigation" data-action="shell#close"><%= fa_icon "times", aria: { hidden: true } %></button>
  </div>
  <nav class="shell-navigation" aria-label="Primary">
    <p class="nav-group-label sidebar-label">Explore</p>
    <%= shell_nav_link "Overview", root_path, "home" %>
    <%= shell_nav_link "Demo dashboard", portfolio_demo_path, "pie-chart" %>
    <%= shell_nav_link "Research policy lab", research_demo_path, "flask" %>
    <% if current_user %>
      <% if Research::Chat.enabled? %>
        <%= shell_nav_link "Research chat", research_chats_path, "comments" %>
      <% end %>
      <p class="nav-group-label sidebar-label">Your workspace</p>
      <%= shell_nav_link "My Portfolio", my_portfolio_path, "list" %>
      <%= shell_nav_link "My Friends", my_friends_path, "users" %>
      <details class="nav-group" open>
        <summary><%= fa_icon "lock", aria: { hidden: true } %><span class="sidebar-label">Private evidence</span><span class="sidebar-label nav-chevron" aria-hidden="true">›</span></summary>
        <%= shell_nav_link "Private connections", broker_connections_path, "plug" %>
        <%= shell_nav_link "Equibles evidence", equibles_evidence_path, "file-text-o" %>
        <%= shell_nav_link "Deposit information gates", deposit_information_path, "shield" %>
      </details>
      <%= shell_nav_link "Synthetic sandbox", sandbox_accounts_path, "cubes", active: controller_name.start_with?("sandbox_") %>
    <% end %>
  </nav>
  <div class="shell-sidebar-footer">
    <p class="sidebar-label">Engineering showcase<br><span>Not a brokerage or live feed</span></p>
    <button type="button" class="shell-nav desktop-collapse" aria-label="Collapse sidebar" aria-controls="application-navigation" aria-expanded="true" data-shell-target="collapseButton" data-action="shell#toggleCollapsed">
      <%= fa_icon "outdent", aria: { hidden: true } %><span class="sidebar-label">Collapse sidebar</span>
    </button>
  </div>
</aside>
