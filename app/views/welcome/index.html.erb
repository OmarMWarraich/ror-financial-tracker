<% content_for :title, "Overview | FinanceTracker" %>
<header class="mb-6">
  <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Portfolio analytics and research demo</p>
  <h1>Your financial engineering workspace</h1>
  <p class="max-w-2xl text-muted-foreground">Explore explainable fictional analytics, review your permitted private evidence, and manage your watchlist. No live orders or funding are available.</p>
</header>
<div class="grid gap-5 md:grid-cols-2">
  <%= render_card title: "Portfolio analytics", subtitle: "Public, fictional USD holdings" do %>
    <div class="p-6 pt-0">
      <p>Review valuation, allocation, cost basis and concentration. Explore missing-data scenarios without contacting a provider.</p>
      <%= render_button "Explore demo dashboard", as: :link, href: portfolio_demo_path %>
    </div>
  <% end %>
  <%= render_card title: "Research policy lab", subtitle: "Deterministic educational fixtures" do %>
    <div class="p-6 pt-0">
      <p>See how untrusted observations are accepted or rejected. This lab never calls an AI model or reads private accounts.</p>
      <%= render_button "Open research policy lab", as: :link, href: research_demo_path, variant: :outline %>
    </div>
  <% end %>
  <% if current_user %>
    <%= render_card title: "Your watchlist", subtitle: "Shared identifiers, not a holdings ledger" do %>
      <div class="p-6 pt-0">
        <p>Manage tracked stocks and search your own permitted Equibles evidence.</p>
        <%= render_button "Open My Portfolio", as: :link, href: my_portfolio_path, variant: :outline %>
      </div>
    <% end %>
    <%= render_card title: "Private connections", subtitle: "Read-only and gated by default" do %>
      <div class="p-6 pt-0">
        <p>Inspect your connection status. Credentials alone do not establish provider approval or enable trading.</p>
        <%= render_button "Review private connections", as: :link, href: broker_connections_path, variant: :outline %>
      </div>
    <% end %>
  <% end %>
</div>
