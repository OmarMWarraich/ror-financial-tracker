<%= turbo_frame_tag "posts" do %>
  <% if @stock.present? %>
    <div class="card card-header d-inline-block my-3">
      <strong>Symbol: </strong> <%= @stock.ticker.upcase %>
      <strong>Name: </strong> <%= @stock.name %>
      <strong>Price: </strong> <span data-testid="shared-quote-unavailable">Unavailable</span>
      <%= link_to "View your private permitted evidence", equibles_evidence_path %>
      <% if current_user.can_track_stock?(@stock.ticker) %>
        <%= link_to 'Add to portfolio', user_stocks_path(user: current_user, ticker: @stock.ticker), 
                                        data: { turbo_method: :post }, class: "btn btn-xs btn-success" %>
      <% else %>
        <span class="badge bg-secondary">
          You are already tracking
          <% if !current_user.under_stock_limit? %>
            10 stocks
          <% end %>
          <% if current_user.stock_already_tracked?(@stock.ticker) %>
            <span class="text-danger"><%= stock.ticker.upcase %></span>
          <% end %>
        </span>
      <% end %>
    </div>
  <% end %>
<% end %>