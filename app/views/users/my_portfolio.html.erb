<h1>My Portfolio</h1>
<p class="text-muted">Your stock watchlist contains identifiers, not holdings or a shared price feed.</p>
<div id="stock-search-results" class="mt-3">
  <h3>Search Stocks</h3>
  <%= render "users/search_form" %>
  <%= turbo_frame_tag "posts" do %>
  <% end %>
  <% if !@tracked_stocks.empty? %>
    <%= render "stocks/list" %>
  <% else %>
    <%= turbo_frame_tag "stocks-list" do %>
      <div class="empty-state"><p class="mb-0">No tracked stocks yet. Search your permitted evidence to add a stock.</p></div>
    <% end %>
  <% end %>
</div>