<%= turbo_frame_tag "friends-search-form" do %>
  <%= form_tag search_friend_path, data: { turbo_stream: :form_response }, method: :get, class: "search-toolbar" do %>
      <div>
        <%= label_tag :friend, "Find a friend" %>
        <%= text_field_tag :friend, nil, placeholder: "Name or email", autofocus: true, class: "form-control" %>
      </div>
      <%= render_button "Search friends", type: :submit %>
  <% end %>  
<% end %>