<div data-market-ranking-date="<%= dashboard[:received_at].utc.to_date.iso8601 %>">
  <% dashboard[:errors].each do |error| %><p role="alert" class="alert alert-warning"><%= error %></p><% end %>
  <section class="mb-6" aria-labelledby="market-five-heading">
    <h2 id="market-five-heading">Top five / interactive price history</h2>
    <p class="text-sm text-muted-foreground">Each chart has its own range and cursor. Hover, touch or use the arrow keys to inspect a daily close. Quotes and historical sessions have separate dates.</p>
    <div data-dashboard-react data-owner-scope="<%= DashboardPreferences.scope(current_user) %>" data-preferences-url="<%= dashboard_preferences_path %>" data-stocks="<%= dashboard[:stocks].first(5).to_json %>">
    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      <% colors = %w[#3b82f6 #059669 #d97706 #8b5cf6 #f43f5e] %>
      <% dashboard[:stocks].first(5).each_with_index do |stock, index| %>
        <%= render "visualization", stock: stock, color: colors[index] %>
      <% end %>
    </div>
    </div>
  </section>
  <div class="grid gap-6 lg:grid-cols-3">
    <section class="min-w-0 lg:col-span-2" aria-label="Selected stock">
      <div data-market-detail>
        <%= render "detail", dashboard: dashboard %>
      </div>
    </section>
    <aside class="min-w-0" aria-label="Top ten stock listings">
      <%= render_card title: "Market leaders", subtitle: "Provider market-cap ranking / retrieved #{dashboard[:received_at].utc.iso8601}" do %>
        <div class="p-4 pt-0">
          <% dashboard[:stocks].each_with_index do |stock, index| %>
            <%= form_with url: refresh_market_dashboard_path, method: :post, data: { turbo: false, action: "submit->market-dashboard#select" }, class: "border-b py-3" do |form| %>
              <%= form.hidden_field :mode, value: "detail" %>
              <%= form.hidden_field :tickers, value: stock[:ticker] %>
              <button type="submit" class="w-full text-left" data-market-listing="<%= stock[:ticker] %>" data-market-name="<%= stock[:name] %>">
                <span class="flex items-start justify-between gap-3">
                  <span><span class="text-xs text-muted-foreground"><%= index + 1 %>.</span> <strong><%= stock[:ticker] %></strong><span class="block text-sm"><%= stock[:name] %></span></span>
                  <span data-market-price="<%= stock[:ticker] %>" data-market-quote-source="<%= stock[:quote]&.[]("source_at") %>"><%= stock[:quote] ? number_to_currency(stock[:quote]["price"]) : "Unavailable" %></span>
                </span>
                <% if stock[:market_cap] %><span class="text-xs text-muted-foreground">Market cap <%= number_to_human(stock[:market_cap], units: { billion: "B", trillion: "T", million: "M" }, precision: 3) %></span><% end %>
              </button>
            <% end %>
          <% end %>
          <% if dashboard[:stocks].length < 10 %><p role="status">Only <%= dashboard[:stocks].length %> listings were supplied. No synthetic stocks added.</p><% end %>
        </div>
      <% end %>
    </aside>
  </div>
</div>
